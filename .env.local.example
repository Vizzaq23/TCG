# Copy to .env.local (or run `npm run setup` to generate automatically with local Supabase).
#
# Local Supabase (default after `npm run setup`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `npx supabase status -o env`>
#   SUPABASE_SERVICE_ROLE_KEY=<from `npx supabase status -o env`>
#
# Hosted Supabase (https://supabase.com/dashboard → Project Settings → API):
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
#   SUPABASE_SERVICE_ROLE_KEY=<service role key — server/import scripts only, never expose to browser>

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JustTCG market prices (server-only — never expose to the browser)
# https://justtcg.com/docs
JUSTTCG_API_KEY=

# Optional: protect POST /api/admin/prices/refresh (Authorization: Bearer …)
PRICE_SYNC_SECRET=

# Shop (Phase 1 storefront) — your Supabase auth user UUID
SHOP_OWNER_USER_ID=

# Public site URL for Stripe redirects (optional; falls back to VERCEL_URL / localhost)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# stripe listen --forward-to localhost:3000/api/shop/webhook
STRIPE_WEBHOOK_SECRET=

# Required explicit tax choice: "none" or "automatic" (Stripe Tax).
STRIPE_TAX_MODE=

# Keep false for test mode. Set true only after an approved live-payment launch.
STRIPE_LIVE_PAYMENTS_ENABLED=false

# Random 32+ character server-only secret used to HMAC checkout rate-limit keys.
SHOP_RATE_LIMIT_SECRET=
