# Copy to .env.local (or run `npm run setup` to generate automatically with local Supabase).
#
# Local Supabase (default after `npm run setup`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `npx supabase status -o env`>
#   SUPABASE_SERVICE_ROLE_KEY=<from `npx supabase status -o env`>
#
# Hosted Supabase (https://supabase.com/dashboard → Project Settings → API):
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
#   SUPABASE_SERVICE_ROLE_KEY=<service role key — server/import scripts only, never expose to browser>

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JustTCG market prices (server-only — never expose to the browser)
# https://justtcg.com/docs
JUSTTCG_API_KEY=

# Optional: protect POST /api/admin/prices/refresh (Authorization: Bearer …)
PRICE_SYNC_SECRET=
