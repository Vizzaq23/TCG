{
  "name": "one-piece-tcg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/node-system-ca.mjs ./node_modules/next/dist/bin/next dev",
    "build": "node scripts/node-system-ca.mjs ./node_modules/next/dist/bin/next build",
    "start": "node scripts/node-system-ca.mjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:catalog": "node scripts/node-system-ca.mjs --import tsx scripts/import-catalog.ts",
    "import:catalog:dry": "node scripts/node-system-ca.mjs --import tsx scripts/import-catalog.ts --dry-run",
    "import:catalog:sql": "node scripts/node-system-ca.mjs --import tsx scripts/import-catalog.ts --sql",
    "import:catalog:json": "node scripts/node-system-ca.mjs --import tsx scripts/import-catalog.ts --json",
    "prices:sync": "node scripts/node-system-ca.mjs --import tsx scripts/sync-justtcg-prices.ts",
    "supabase": "supabase",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.72.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "framer-motion": "^12.42.2",
    "next": "^16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.25.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "supabase": "^2.110.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
